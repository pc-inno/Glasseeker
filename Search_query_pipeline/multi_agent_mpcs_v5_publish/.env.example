# Public template: credentials, provider endpoints, model names and local paths removed.
# Fill DEFAULT_MODEL and optional per-agent *_MODEL values for your provider.
# Values are literal: this project does not expand $VARIABLE or ~ in env files.
# Copy to a private .env file and fill in credentials and paths.

# start_v5p1.sh configures the bundled Hermes checkout automatically.
V2_HERMES_TOOL_WORKSPACE_ROOT=data/tool_workspaces
# V2_HERMES_SOLVER_WORKSPACE_ROOT=/tmp/multi_agent_mpcs_solver_workspaces
# V2_HERMES_PATH=
# p7 reapplies these after Hermes loads HERMES_HOME/.env. Empty means local browser.
V2_HERMES_BROWSER_CDP_URL=
V2_HERMES_AGENT_BROWSER_AUTO_CONNECT=

# Shared model credentials.
DEFAULT_API_KEY=
DEFAULT_BASE_URL=
DEFAULT_MODEL=
DEFAULT_PROVIDER=custom
DEFAULT_BACKEND=hermes
DEFAULT_TOOLSETS=

# Optional per-agent overrides.
# SEED_MODEL=
# SEED_VERIFIER_MODEL=
# CONSTRAINT_MODEL=
V2_ROOT_AMBIGUITY_VERIFIER_ENABLED=1
# LOCAL_CONSTRAINT_MODEL=
# QUESTION_MODEL=
# QUESTION_FALLBACK_MODEL=gpt-5.6-sol
# QUESTION_REPAIR_MODEL=gpt-5.5
# QUESTION_REPAIR_BACKEND=hermes
# UNIQUENESS_MODEL=
# UNIQUENESS_BACKEND=
# SOLVER_MODEL=
# SOLVER_VERIFIER_MODEL=
# SOLVER_VERIFIER_JUDGE_MAX_TOKENS=2048
# SOLVER_VERIFIER_TOKEN_PARAM=max_completion_tokens
# SOLVER_VERIFIER_TEMPERATURE=1.0
# SOLVER_VERIFIER_TOP_P=1.0
# SOLVER_VERIFIER_TIMEOUT_SECONDS=300
# SOLVER_VERIFIER_DIRECT_MAX_ATTEMPTS=3

# Workflow controls.
V2_OUTPUT_DIR=data/runs
V2_SEED_CONCURRENCY=1
V2_SEED_VERIFIER_ENABLED=1
V2_SEED_REPAIR_ENABLED=1
V2_SEED_REPAIR_RETRIES=1
V2_SEED_VERIFIER_ROLLOUTS=2
V2_SEED_CARDINALITY_ROLLOUTS=1
V2_MEMORY_GUARD_ENABLED=1
V2_MEMORY_GUARD_MAX_USAGE_RATIO=0.85
V2_MEMORY_GUARD_HARD_USAGE_RATIO=0.97
V2_MEMORY_GUARD_MIN_AVAILABLE_MB=6144
V2_MEMORY_GUARD_RESERVATION_MB=1024
# Optional per-agent override; normalized agent name is appended to the key.
# V2_MEMORY_GUARD_RESERVATION_MB_SOLVER=512
V2_MEMORY_GUARD_POLL_SECONDS=5
V2_MEMORY_GUARD_START_INTERVAL_SECONDS=1
V2_MEMORY_GUARD_LOG_INTERVAL_SECONDS=30
V2_MEMORY_GUARD_MAX_WAIT_SECONDS=300
V2_MEMORY_RECLAIM_ENABLED=1
V2_MEMORY_RECLAIM_TARGET_RATIO=0.75
V2_MEMORY_RECLAIM_MIN_MB=8192
V2_MEMORY_RECLAIM_MAX_MB=24576
V2_MEMORY_RECLAIM_COOLDOWN_SECONDS=300
V2_MEMORY_RECLAIM_SWAPPINESS=0
V2_HERMES_OOM_SCORE_ADJ=500
V2_MIN_DOMAIN_COVERAGE=30
V2_MAX_SEEDS_PER_SOURCE_DOMAIN=2
V2_UNIQUENESS_ENABLED=1
V2_UNIQUENESS_ROLLOUTS=1
V2_UNIQUENESS_REQUIRE_CONSENSUS=1
V2_UNIQUENESS_ALLOW_UNCERTAIN_AFTER_REPAIR=1
V2_BLIND_UNIQUENESS_ENABLED=1
V2_ANSWER_CARDINALITY_ENABLED=1
# ANSWER_CARDINALITY_MODEL=gpt-5.6-sol
V2_SOLVER_ENABLED=1
V2_SOLVER_ROLLOUTS=3
V2_SOLVER_MIN_SUCCESS_API_CALLS=20
V2_SOLVER_MIN_SUCCESS_TOOL_CALLS=40
V2_SOLVER_RELAXED_MIN_SUCCESS_API_CALLS=10
V2_SOLVER_RELAXED_MIN_SUCCESS_TOOL_CALLS=20
V2_SOLVER_TOO_EASY_API_CALLS=5
V2_SOLVER_ACCEPT_API_CALLS=0
V2_SOLVER_CONTINUE_PRUNING=1
V2_SOLVER_PRUNING_REVISIONS=3
V2_SOLVER_PRUNE_TARGET_API_CALLS=50
V2_SOLVER_PRUNE_TARGET_TOOL_CALLS=80
SOLVER_AMBIGUITY_MODEL=
SOLVER_AMBIGUITY_MAX_ITERATIONS=18
SOLVER_AMBIGUITY_TOOLSETS=web
V2_SOLVER_TRACE_SUMMARY_ENABLED=1
V2_SOLVER_CONCURRENCY=1
V2_LOCAL_CONCURRENCY=2
V2_MIN_CORE_PATHS=4
V2_MIN_DISTRACTOR_PATHS=3
V2_MAX_DISTRACTOR_PATHS=5
V2_MIN_SINGLE_CANDIDATES=20
V2_MAX_SINGLE_CANDIDATES=500
V2_MIN_PAIRWISE_CORE_INTERSECTION=2
V2_MIN_DISTRACTOR_CORE_OVERLAP=3
V2_MIN_DISTRACTORS_PER_CORE=1
V2_LOCAL_MIN_CORE_PATHS=3
V2_LOCAL_MIN_DISTRACTOR_PATHS=1
V2_LOCAL_MIN_RELATION_CORE_PATHS=2
V2_LOCAL_MIN_ATTRIBUTE_CORE_PATHS=1
V2_LOCAL_MAX_DEPTH=5
V2_LOCAL_CORE_MAX_DEPTH=5
V2_LOCAL_DISTRACTOR_MAX_DEPTH=5
V2_LOCAL_EXPAND_MIN_PATHS=1
V2_LOCAL_EXPAND_MAX_PATHS=3
V2_LOCAL_EXPAND_CORE_MIN_PATHS=2
V2_LOCAL_EXPAND_CORE_MAX_PATHS=3
V2_LOCAL_EXPAND_DISTRACTOR_MIN_PATHS=0
V2_LOCAL_EXPAND_DISTRACTOR_MAX_PATHS=1
V2_LOCAL_EXPAND_DISTRACTOR_PROB=0.3
V2_LOCAL_EXPAND_ROLES=core,distractor
V2_LOCAL_MAX_DEEP_PATHS=1
V2_LOCAL_MAX_DEEP_PATHS_DISTRACTOR=1
V2_LOCAL_DEEP_PATH_ROLES=core
V2_REQUIRE_LOCAL_VERIFICATION=1
V2_REQUIRE_LOCAL_EXPANSION=1
V2_QUESTION_MIN_LEAF_DEPTH=3
V2_QUESTION_MIN_LEAF_CORE_PATHS=3
V2_QUESTION_MIN_ROOT_CORE_CHILDREN=1
V2_QUESTION_MIN_ROOT_NON_SHORTCUT_CHILDREN=0
V2_QUESTION_REQUIRE_ALL_CORE_LEAF=0
V2_QUESTION_FORBID_CORE_ROOT_FALLBACK=1
V2_QUESTION_REPAIR_ENABLED=1
V2_QUESTION_VALIDATION_REPAIR_ATTEMPTS=2
V2_QUESTION_VERIFIER_ENABLED=1
V2_QUESTION_MAX_WORDS=220
V2_AGENT_TIMEOUT_SECONDS=900
V2_AGENT_RETRIES=2
V2_AGENT_RETRY_SLEEP_SECONDS=20
V2_AGENT_RETRY_MAX_SLEEP_SECONDS=120
V2_RATE_LIMIT_GUARD_ENABLED=1
# 0 derives each seed's initial cap from the matching workflow concurrency setting.
V2_RATE_LIMIT_MAX_INFLIGHT=0
V2_RATE_LIMIT_MIN_CONCURRENCY=1
V2_RATE_LIMIT_COOLDOWN_SECONDS=30
V2_RATE_LIMIT_MAX_COOLDOWN_SECONDS=300
V2_RATE_LIMIT_RECOVERY_SUCCESSES=20
SEED_TIMEOUT_SECONDS=900
QUESTION_REPAIR_TIMEOUT_SECONDS=900
V2_LOCAL_AGENT_RETRIES=3
V2_LOCAL_AGENT_RETRY_SLEEP_SECONDS=20
V2_LOCAL_VERIFICATION_RETRIES=3
V2_LOCAL_QUALITY_VERIFIER_ENABLED=1
V2_LOCAL_MIN_NON_SHORTCUT_ROOT_CORES=0
V2_VERBOSE_PROGRESS=1
V2_MAX_REVISIONS=7
V2_QUESTION_REVISIONS=5
V2_CONVERSATION_LOG=1
# V2_CONVERSATION_LOG_DIR=data/runs/conversations
V2_HERMES_DEBUG=0
